<Grid x:Class="CPUSetSetter.UI.Tabs.Masks.MasksTab"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:CPUSetSetter.UI.Tabs.Masks"
      xmlns:config="clr-namespace:CPUSetSetter.Config.Models"
      xmlns:ui="clr-namespace:CPUSetSetter.UI"
      xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
      d:DataContext="{d:DesignInstance Type=local:MasksTabViewModel}"
      mc:Ignorable="d"
      Margin="5">

    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Mask list and Create/Remove buttons-->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!--List of existing masks-->
            <ListBox Grid.Row="0" Margin="0,0,0,10"
                     ItemsSource="{Binding LogicalProcessorMasks, Source={x:Static config:AppConfig.Instance}}"
                     SelectedValue="{Binding SelectedMask, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     dd:DragDrop.IsDragSource="True"
                     dd:DragDrop.IsDropTarget="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--Create/Remove buttons-->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Margin="0,0,5,0"
                        Content="新建…"
                        Command="{Binding CreateNewMaskCommand}"/>
                <Button Grid.Column="1" Margin="5,0,0,0"
                        Content="删除"
                        Command="{Binding RemoveMaskCommand}"
                        IsEnabled="{Binding CanRemoveMask}"/>
            </Grid>
        </Grid>

        <!--Settings of the selected mask-->
        <local:MaskEditorControl Grid.Column="1" Margin="10,0,0,0"
                                 BoolMask="{Binding SelectedMask.BoolMask}"
                                 Hotkeys="{Binding SelectedMask.Hotkeys}"
                                 MaskType="{Binding SelectedMask.MaskType, Mode=TwoWay}"/>
    </Grid>

    <Separator Grid.Row="1"/>

    <TextBlock Grid.Row="2">
        <TextBlock.Inlines>
            <Run Text="在此管理核心掩码。核心掩码用于指定进程可以在哪些 CPU 核心上运行。"/>
            <Run Text="&#x0a;创建掩码后，可在进程选项卡中选择并应用到进程。"/>
            <Run Text="&#x0a;还可以为掩码设置快捷键，无需切换窗口即可应用到当前前台进程。"/>
        </TextBlock.Inlines>
    </TextBlock>

</Grid>
